{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@glaicer/supercode-plugin-updater",
  "version": "0.1.0",
  "description": "OpenCode TUI plugin: daily update check for npm plugins and managed tools, with an interactive /plugin-updates screen",
  "type": "module",
  "license": "MIT",
  "author": "Dmitrii Aronov <aronov.mml@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Glaicer/supercode-plugin-updater.git"
  },
  "homepage": "https://github.com/Glaicer/supercode-plugin-updater#readme",
  "bugs": "https://github.com/Glaicer/supercode-plugin-updater/issues",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui-plugin",
    "plugin-updater"
  ],
  "exports": {
    "./tui": "./src/update-checker.tsx"
  },
  "files": [
    "src",
    "!src/*.test.ts",
    "!src/fake-tui-api.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.17.8",
    "@opencode-ai/sdk": "1.17.8",
    "@opentui/solid": "0.3.4",
    "@types/node": "24.13.3",
    "solid-js": "1.9.12",
    "typescript": "5.8.2"
  },
  "engines": {
    "node": ">=24"
  }
}
